    {
      "parameters": {
        "jsCode": "const sender = $(\"Normalize Inbound\").first().json.sender;\nconst rows = $input.all().map(i => i.json);\n\nconst now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst filtered = rows.filter(r => {\n  if (r.sender !== sender) return false;\n  const d = new Date(r.date);\n  return d >= sevenDaysAgo && r.parse_status !== \"raw_only\";\n});\n\nconst byDate = {};\nfor (const r of filtered) {\n  byDate[r.date] = byDate[r.date] || { productive: 0, distraction: 0 };\n  const dur = Number(r.duration_min) || 0;\n  if (r.category === \"Trading/Build\" || r.category === \"Agency Work\") byDate[r.date].productive += dur;\n  if (r.category === \"Distraction\") byDate[r.date].distraction += dur;\n}\n\nconst dates = Object.keys(byDate).sort();\nlet bestDay = null, worstDay = null;\nfor (const d of dates) {\n  const net = byDate[d].productive - byDate[d].distraction;\n  if (bestDay === null || net > byDate[bestDay].productive - byDate[bestDay].distraction) bestDay = d;\n  if (worstDay === null || net < byDate[worstDay].productive - byDate[worstDay].distraction) worstDay = d;\n}\n\nconst totalProductive = filtered.filter(r => r.category === \"Trading/Build\" || r.category === \"Agency Work\")\n  .reduce((a, r) => a + (Number(r.duration_min) || 0), 0);\nconst totalDistraction = filtered.filter(r => r.category === \"Distraction\")\n  .reduce((a, r) => a + (Number(r.duration_min) || 0), 0);\n\nfunction fmt(min) {\n  const h = Math.floor(min / 60);\n  const m = min % 60;\n  return h ? `${h}h ${m}m` : `${m}m`;\n}\n\nconst text = `WEEKLY REPORT\nBest day: ${bestDay || \"n/a\"}\nWorst day: ${worstDay || \"n/a\"}\nTotal productive: ${fmt(totalProductive)}\nTotal distraction: ${fmt(totalDistraction)}\n\nBRUTAL TRUTH:\n${totalDistraction > totalProductive ? \"This week the phone beat your ambitions. Fix tomorrow, not next Monday.\" : \"This week you outworked distraction. Keep the ratio.\"}`;\n\nreturn [{ json: { sender, report_text: text } }];"
      },
