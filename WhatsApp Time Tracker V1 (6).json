    {
      "parameters": {
        "jsCode": "const t = ($json.message_text || \"\").trim();\n\nfunction categoryFromText(s) {\n  if (/(trade|trading|chart|nse|market)/i.test(s)) return \"Trading/Build\";\n  if (/(automation|agency|client|lead|website|n8n)/i.test(s)) return \"Agency Work\";\n  if (/(scroll|instagram|youtube|phone|waste|wasted)/i.test(s)) return \"Distraction\";\n  if (/(pray|prayer|masjid|gym|family|wife|bath|breakfast|lunch|dinner)/i.test(s)) return \"Fuel\";\n  return \"Idle\";\n}\n\nlet duration_min = null;\nlet start_time = \"\";\nlet end_time = \"\";\nlet parse_status = \"raw_only\";\n\nconst range = t.match(/(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm)?\\s*(?:to|-)\\s*(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm)?/i);\n\nif (range) {\n  const [, h1, m1 = \"00\", ap1, h2, m2 = \"00\", ap2] = range;\n  function to24(h, m, ap) {\n    let hh = parseInt(h, 10);\n    if (ap) {\n      const a = ap.toLowerCase();\n      if (a === \"pm\" && hh !== 12) hh += 12;\n      if (a === \"am\" && hh === 12) hh = 0;\n    }\n    return `${String(hh).padStart(2, \"0\")}:${String(parseInt(m, 10)).padStart(2, \"0\")}`;\n  }\n  start_time = to24(h1, m1, ap1);\n  end_time = to24(h2, m2, ap2);\n  const [sh, sm] = start_time.split(\":\").map(Number);\n  const [eh, em] = end_time.split(\":\").map(Number);\n  duration_min = (eh * 60 + em) - (sh * 60 + sm);\n  if (duration_min < 0) duration_min += 24 * 60;\n  parse_status = \"time_range\";\n} else {\n  const d = t.match(/(\\d+)\\s*(min|mins|minute|minutes|hr|hrs|hour|hours)/i);\n  if (d) {\n    const n = parseInt(d[1], 10);\n    const u = d[2].toLowerCase();\n    duration_min = /hr|hour/.test(u) ? n * 60 : n;\n    parse_status = \"explicit_duration\";\n  }\n}\n\nreturn [{\n  json: {\n    ...$json,\n    start_time,\n    end_time,\n    duration_min,\n    parse_status,\n    raw_text: t,\n    activity: t,\n    category: categoryFromText(t),\n    report_scope: \"\"\n  }\n}];"
      },
