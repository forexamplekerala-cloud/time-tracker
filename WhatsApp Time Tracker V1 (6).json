    {
      "parameters": {
        "jsCode": "const sender = $(\"Normalize Inbound\").first().json.sender;\nconst today = $(\"Normalize Inbound\").first().json.date;\nconst rows = $input.all().map(i => i.json);\n\nconst filtered = rows.filter(r => r.sender === sender && r.date === today);\nconst valid = filtered.filter(r => r.parse_status !== \"raw_only\");\n\nfunction sum(cat) {\n  return valid.filter(r => r.category === cat).reduce((a, r) => a + (Number(r.duration_min) || 0), 0);\n}\n\nconst trading = sum(\"Trading/Build\");\nconst agency = sum(\"Agency Work\");\nconst distraction = sum(\"Distraction\");\nconst fuel = sum(\"Fuel\");\nconst idle = sum(\"Idle\");\nconst total = trading + agency + distraction + fuel + idle;\n\nfunction fmt(min) {\n  const h = Math.floor(min / 60);\n  const m = min % 60;\n  if (h && m) return `${h}h ${m}m`;\n  if (h) return `${h}h`;\n  return `${m}m`;\n}\nfunction pct(x) { return total ? Math.round((x / total) * 100) : 0; }\n\nconst brutal = distraction > agency + trading\n  ? \"Distraction beat real work today. The phone is winning.\"\n  : \"Work beat drift today. Do it again tomorrow.\";\n\nconst text = `DAILY REPORT\n${today}\nTrading+Build: ${fmt(trading)} (${pct(trading)}%)\nAgency Work: ${fmt(agency)} (${pct(agency)}%)\nDistraction: ${fmt(distraction)} (${pct(distraction)}%)\nFuel: ${fmt(fuel)} (${pct(fuel)}%)\nIdle: ${fmt(idle)} (${pct(idle)}%)\nTOTAL PARSED: ${fmt(total)}\n\nBRUTAL TRUTH:\n${brutal}`;\n\nreturn [{ json: { sender, report_text: text } }];"
      },
